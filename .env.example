# 前端只保存 provider 名称，绝不保存密钥。
# 可选：mock | glm | qwen | openai | anthropic
VITE_AI_PROVIDER=mock

# 以下两项仅由 npm start 的本机服务读取，不会进入 dist。
AI_PROVIDER=mock
AI_KEY=

# 智谱：两个 provider 都改为 glm，AI_KEY 填智谱密钥。
# 视觉 glm-4v-flash；文本 glm-4-flash。
# 通义千问：qwen；视觉 qwen-vl-max；文本 qwen-plus。
# OpenAI：openai；视觉和文本均为 gpt-4o。
# Anthropic：anthropic；视觉和文本均为 claude-sonnet-4-20250514。
# 不再使用 VITE_AI_KEY；已有 Key 应迁移到 AI_KEY。
# 修改前端 provider 后重新 build；修改 AI_KEY 后重新 npm start。
# 未配置时自动降级 mock；本机代理不可直接用于公网部署。
